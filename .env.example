# ==========================================================
# Variables de Entorno del Servidor Express (NO usar prefijo VITE_)
# ==========================================================

# Puerto del servidor Express
PORT=3000

# Contraseña para el Portal Administrativo (verificada exclusivamente en Express)
ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"

# Secreto HMAC-SHA256 para firmar tokens de sesión (TTL estricto de 8 horas)
ADMIN_SESSION_SECRET="CHANGE_ME_64_CHAR_RANDOM_SECRET_KEY"

# GEMINI_API_KEY: Opcional para el Copiloto Escolar IA en el servidor
GEMINI_API_KEY=""

# APP_URL: URL base donde se aloja la aplicación
APP_URL="http://localhost:3000"
